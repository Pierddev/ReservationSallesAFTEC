# Node server port
PORT=8000
# Database port
DB_NAME=name_of_your_database
DB_HOST=localhost
DB_PORT=3306
DB_USER=database_username
DB_PASSWORD=database_user_password
# Key for encrypting cookies
JWT_SECRET=YOUR_JWT_SECRET
# Site URL in production (e.g., https://monsite.com)
URL_SITE=http://localhost:5173